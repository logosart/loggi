{
  "name": "bipe-unico-desktop",
  "version": "0.1.0",
  "description": "Desktop app for Bipe Unico with Supabase login and subscription gating.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.bikeunico.desktop",
    "productName": "Bipe Único",
    "files": [
      "src/**/*",
      "automation/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "automation",
        "to": "automation"
      }
    ],
    "win": {
      "target": "portable"
    }
  }
}
